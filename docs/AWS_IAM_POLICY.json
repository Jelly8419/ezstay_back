{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSecurityGroupForGitHubActions",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "github-actions"
        }
      }
    }
  ]
}
