# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ezstay

# JWT (최소 32자 이상의 랜덤 문자열 사용 필수)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-minimum-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/oauth/kakao/callback

# Frontend URL (카카오 로그인 후 리디렉트 대상)
FRONTEND_URL=http://localhost:3000

# Toss Payments (결제 위젯 연동 키)
# 테스트 키 발급: https://developers.tosspayments.com
TOSS_CLIENT_KEY=test_ck_OEP59LybZ8BN3Y1Y7kVrwYxAdXy1
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
TOSS_WEBHOOK_SECRET=test_webhook_secret_12345

# Payment Mock Mode (개발/테스트용)
# true로 설정하면 토스 API 호출 없이 Mock 결제 테스트 가능
PAYMENT_MOCK_MODE=false

# Upload Path
UPLOAD_PATH=./uploads/rooms
UPLOADS_PUBLIC_PATH=./uploads

# Server
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # 비밀번호가 있는 경우 주석 해제

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Timezone
TZ=Asia/Seoul

# Email Service (SendGrid)
# SendGrid API Key 발급: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
EMAIL_FROM=Ezstay <noreply@ezstay.com>
EMAIL_VERIFICATION_CODE_EXPIRES_IN=300  # 인증코드 만료 시간 (초, 기본 5분)