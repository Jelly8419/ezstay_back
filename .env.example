# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ezstay

# JWT (최소 32자 이상의 랜덤 문자열 사용 필수)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-minimum-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/oauth/kakao/callback

# Frontend URL (카카오 로그인 후 리디렉트 대상)
FRONTEND_URL=http://localhost:3000

# PayTag Payments (결제 연동 키)
# 테스트 키 발급: PayTag 가맹점 관리자
PAYTAG_API_URL=https://apit.paytag.kr
PAYTAG_SHOPCODE=1901110002
PAYTAG_SERVICECODE=PAYTAG
PAYTAG_API_KEY=Q)6FpZdJ~PQJ*I[l5fs$I_ADN@BS#$h)
PAYTAG_LOGIN_ID=your-paytag-login-id  # 취소 API 필수값 (페이태그 가맹점 로그인 ID)

# 공공데이터포털 한국천문연구원 특일 정보 API (공휴일 포함 영업일 계산용)
# 발급: https://www.data.go.kr → 한국천문연구원_특일 정보 → 활용신청
PUBLIC_DATA_API_KEY=893df996597bb5ef88d13c9657d62c802db383402d926e3db146f98fbb29cedd

# Payment Mock Mode (개발/테스트용)
# true로 설정하면 PayTag API 호출 없이 Mock 결제 테스트 가능
PAYMENT_MOCK_MODE=false

# Payment Test Amount (개발/테스트용)
# 설정하면 PG 결제 시 실제 금액 대신 이 금액으로 결제하고, DB에는 원래 금액 저장
# 프론트 SDK에서도 동일 금액으로 tran_amt를 설정해야 함
# PAYMENT_TEST_AMOUNT=100

# Default Deposit Amount (보증금, 원 단위)
# 런칭 시 300000으로 변경, 테스트 시 1000 등 소액 설정 가능
DEFAULT_DEPOSIT=300000

# Auto Approve Contracts (개발/테스트용)
# true로 설정하면 계약 생성 시 자동으로 APPROVED 상태로 승인됨
# 프로덕션 환경에서는 자동으로 비활성화됨 (안전장치)
# AUTO_APPROVE_CONTRACTS=true

# Upload Path
UPLOAD_PATH=./uploads/rooms
UPLOADS_PUBLIC_PATH=./uploads

# Server
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # 비밀번호가 있는 경우 주석 해제

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Timezone
TZ=Asia/Seoul

# Email Service (AWS SES)
AWS_SES_REGION=ap-northeast-2
AWS_SES_ACCESS_KEY_ID=AKIA6IYKPQ7WWMJQXT4E
AWS_SES_SECRET_ACCESS_KEY=your-aws-ses-secret-access-key
EMAIL_FROM=Ezstay <noreply@ezstay.com>
EMAIL_VERIFICATION_CODE_EXPIRES_IN=300  # 인증코드 만료 시간 (초, 기본 5분)

# KMC 본인인증
KMC_CP_ID=your-kmc-cp-id                    # KMC 고객사 ID
KMC_URL_CODE=your-kmc-url-code              # KMC URL 코드
KMC_CRYPTO_PATH=/path/to/KmcCrypto          # KmcCrypto 바이너리 경로 (Linux 서버)
KMC_RESULT_URL=https://yourdomain.com/api/auth/kmc/callback  # 인증 결과 수신 URL
KMC_SERVER_IPS=1.2.3.4,5.6.7.8                              # KMC 서버 IP (쉼표 구분, 빈 값이면 화이트리스트 비활성화)